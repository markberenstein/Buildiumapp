# Copy this to .env (or set these in your host's environment settings)
BUILDIUM_CLIENT_ID=your_client_id_here
BUILDIUM_CLIENT_SECRET=your_client_secret_here

# Optional
PORT=5000
CACHE_SECONDS=120

# Required for the testing/screenshot mode (see README "Testing mode" section)
ADMIN_PASSWORD=Buildium123$
SECRET_KEY=any_random_string_for_session_signing
